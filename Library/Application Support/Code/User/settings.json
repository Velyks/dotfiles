{
    "editor.tabSize": 2,
    "git.autofetch": true,
    "git.confirmSync": false,
    "gitlens.hovers.currentLine.over": "line",
    "gitlens.currentLine.enabled": false,
    "gitlens.hovers.enabled": false,
    "gitlens.mode.statusBar.enabled": false,
    "git.enableSmartCommit": true,
    "files.autoSave":"afterDelay",
    "files.autoSaveDelay": 10000,
    "files.insertFinalNewline": true,
    "files.trimTrailingWhitespace": true,
    "files.trimFinalNewlines": true,
    "editor.fontFamily": "JetBrains Mono",
    "editor.fontLigatures": true,
    "python.formatting.provider": "black",
    "python.formatting.blackPath": "black",
    "python.linting.pylintEnabled": false,
    "python.linting.flake8Enabled": true,
    "python.linting.flake8Args": ["--max-line-length=100"],
    "python.testing.unittestEnabled": false,
    "python.testing.pytestEnabled": false,
    "python.testing.nosetestsEnabled": false,
    "[python]": {
        "editor.tabSize": 4,
        "editor.rulers": [100],
        "editor.formatOnPaste": false,
        "editor.formatOnSave": true,
        "editor.codeActionsOnSave": {
            "source.organizeImports": false,
        },
    },
    "python.jediEnabled": true,
    "python.venvFolders": [
        "envs",
        ".pyenv",
        ".direnv",
        ".virtualenvs",
        ".venv",
        "venv"
    ],
    "editor.minimap.enabled": false,
    "breadcrumbs.enabled": true,
    "editor.codeLens": false,
    "[terraform]": {
        "editor.tabSize": 2,
        "editor.insertSpaces": true,
        "editor.detectIndentation": false,
        "editor.formatOnSave": true
    },
    "gitlens.views.fileHistory.enabled": true,
    "gitlens.views.fileHistory.location": "scm",
    "gitlens.views.lineHistory.location": "scm",
    "workbench.colorTheme": "Atom One Dark",
    "terminal.external.osxExec": "iterm2.app",
    "terminal.integrated.fontSize": 12,
    "terminal.integrated.fontFamily": "FuraCode Nerd Font",
    "python.terminal.activateEnvironment": false,
    "workbench.colorCustomizations": {
        "terminal.background": "#272b33",
        "terminal.foreground": "#a5adbd",
        "terminalCursor.foreground": "#4868a6",
        "terminal.ansiBlack": "#272c33",
        "terminal.ansiBrightBlack": "#31353f",
        "terminal.ansiRed": "#e06b74",
        "terminal.ansiBrightRed": "#f97782",
        "terminal.ansiGreen": "#98c378",
        "terminal.ansiBrightGreen": "#aadb87",
        "terminal.ansiYellow": "#e5c07a",
        "terminal.ansiBrightYellow": "#ffd589",
        "terminal.ansiBlue": "#60aeee",
        "terminal.ansiBrightBlue": "#68bbfe",
        "terminal.ansiMagenta": "#c677dc",
        "terminal.ansiBrightMagenta": "#dc85f7",
        "terminal.ansiCyan": "#56b6c1",
        "terminal.ansiBrightCyan": "#60ccdb",
        "terminal.ansiWhite": "#abb1bf",
        "terminal.ansiBrightWhite": "#b1b9cb"
    },
    "workbench.editor.showTabs": true,
    "workbench.iconTheme": "material-icon-theme",
    "extensions.ignoreRecommendations": true,
    "editor.renderWhitespace": "all",
    "editor.renderControlCharacters": false,
    "terraform.indexing": {
        "enabled": false,
        "liveIndexing": false,
        "delay": 500,
        "exclude": [
            ".terraform/**/*",
            "**/.terraform/**/*"
        ]
    },
    "terraform.languageServer": {
        "external": true,
        "pathToBinary": "",
        "args": [
            "serve"
        ],
        "maxNumberOfProblems": 100,
        "trace.server": "off"
    },
    "diffEditor.ignoreTrimWhitespace": false,
    "vs-kubernetes.kubectl-path": "/usr/local/bin/kubectl",
    "python.languageServer": "Jedi",
    "peacock": {
        "affectActivityBar": false,
        "affectStatusBar": true,
        "affectTitleBar": true,
        "surpriseMeOnStartup": true
    },
    "workbench.editorAssociations": {
        "*.ipynb": "jupyter.notebook.ipynb"
    },
    "redhat.telemetry.enabled": false,
    "security.workspace.trust.untrustedFiles": "open"
}
