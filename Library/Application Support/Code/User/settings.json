{
    "editor.tabSize": 2,
    "editor.formatOnSave": true,
    "git.autofetch": true,
    "git.confirmSync": false,
    "git.rebaseWhenSync": true,
    "git.enableSmartCommit": true,
    "git.ignoredRepositories": [
        "/Users/thomassands"
    ],
    "gitlens.hovers.currentLine.over": "line",
    "gitlens.currentLine.enabled": false,
    "gitlens.hovers.enabled": false,
    "gitlens.mode.statusBar.enabled": false,
    "files.autoSave": "afterDelay",
    "files.autoSaveDelay": 10000,
    "files.insertFinalNewline": true,
    "files.trimTrailingWhitespace": true,
    "files.trimFinalNewlines": true,
    "editor.fontFamily": "JetBrains Mono",
    "editor.fontSize": 14,
    "editor.fontLigatures": true,
    "python.testing.unittestEnabled": false,
    "python.testing.pytestEnabled": false,
    "[python]": {
        "editor.tabSize": 4,
        "editor.rulers": [
            120
        ],
        "editor.formatOnPaste": false,
        "editor.formatOnSave": true,
        "editor.codeActionsOnSave": {
            "source.organizeImports": "never"
        },
        "editor.formatOnType": true,
        "editor.defaultFormatter": "charliermarsh.ruff"
    },
    "editor.minimap.enabled": false,
    "breadcrumbs.enabled": true,
    "editor.codeLens": true,
    "[terraform]": {
        "editor.tabSize": 2,
        "editor.insertSpaces": true,
        "editor.detectIndentation": false,
        "editor.formatOnSave": false,
        "editor.defaultFormatter": "hashicorp.terraform",
        "editor.formatOnSaveMode": "file"
    },
    "[terraform-vars]": {
        "editor.tabSize": 2,
        "editor.insertSpaces": true,
        "editor.detectIndentation": false,
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "hashicorp.terraform",
        "editor.formatOnSaveMode": "file"
    },
    "gitlens.views.fileHistory.enabled": true,
    "gitlens.views.fileHistory.location": "scm",
    "gitlens.views.lineHistory.location": "scm",
    "terminal.external.osxExec": "iterm2.app",
    "terminal.integrated.fontSize": 12,
    "terminal.integrated.fontFamily": "JetBrains Mono NL",
    "terminal.integrated.scrollback": 5000,
    "python.terminal.activateEnvironment": true,
    "workbench.colorCustomizations": {
        "terminal.background": "#272b33",
        "terminal.foreground": "#a5adbd",
        "terminalCursor.foreground": "#4868a6",
        "terminal.ansiBlack": "#272c33",
        "terminal.ansiBrightBlack": "#31353f",
        "terminal.ansiRed": "#e06b74",
        "terminal.ansiBrightRed": "#f97782",
        "terminal.ansiGreen": "#98c378",
        "terminal.ansiBrightGreen": "#aadb87",
        "terminal.ansiYellow": "#e5c07a",
        "terminal.ansiBrightYellow": "#ffd589",
        "terminal.ansiBlue": "#60aeee",
        "terminal.ansiBrightBlue": "#68bbfe",
        "terminal.ansiMagenta": "#c677dc",
        "terminal.ansiBrightMagenta": "#dc85f7",
        "terminal.ansiCyan": "#56b6c1",
        "terminal.ansiBrightCyan": "#60ccdb",
        "terminal.ansiWhite": "#abb1bf",
        "terminal.ansiBrightWhite": "#b1b9cb"
    },
    "workbench.editor.showTabs": "multiple",
    "workbench.iconTheme": "vscode-icons",
    "extensions.ignoreRecommendations": true,
    "editor.renderWhitespace": "all",
    "editor.renderControlCharacters": false,
    "terraform.indexing": {
        "enabled": true,
        "liveIndexing": true,
        "delay": 500,
        "exclude": [
            ".terraform/**/*",
            "**/.terraform/**/*"
        ]
    },
    "python.languageServer": "Pylance",
    "peacock": {
        "affectActivityBar": false,
        "affectStatusBar": true,
        "affectTitleBar": true,
        "surpriseMeOnStartup": true
    },
    "workbench.editorAssociations": {
        "*.ipynb": "jupyter-notebook"
    },
    "redhat.telemetry.enabled": false,
    "security.workspace.trust.untrustedFiles": "open",
    "notebook.cellToolbarLocation": {
        "default": "right",
        "jupyter-notebook": "left"
    },
    "vs-kubernetes": {
        "vs-kubernetes.kubectl-path.mac": "/usr/local/bin/kubectl",
        "vs-kubernetes.minikube-path.mac": "/Users/thomassands/.vs-kubernetes/tools/minikube/darwin-amd64/minikube",
        "vs-kubernetes.helm-path.mac": "/usr/local/bin/helm",
        "vs-kubernetes.crd-code-completion": "disabled",
        "vs-kubernetes.ignore-recommendations": true,
        "vs-kubernetes.minikube-show-information-expiration": "2023-05-22T10:49:11.189Z"
    },
    "github-enterprise.uri": "https://git.lystit.com",
    "githubPullRequests.defaultMergeMethod": "merge",
    "githubPullRequests.pullBranch": "never",
    "githubPullRequests.fileListLayout": "tree",
    "terraform.languageServer.enable": true,
    "terraform.languageServer.path": "",
    "githubPullRequests.createOnPublishBranch": "never",
    "vsicons.dontShowNewVersionMessage": true,
    "workbench.colorTheme": "Atom One Dark",
    "githubIssues.queries": [
        {
            "label": "My Issues",
            "query": "default"
        },
        {
            "label": "Created Issues",
            "query": "author:${user} state:open repo:${owner}/${repository} sort:created-desc"
        },
        {
            "label": "Recent Issues",
            "query": "state:open repo:${owner}/${repository} sort:updated-desc"
        }
    ],
    "diffEditor.ignoreTrimWhitespace": false,
    "editor.stickyScroll.enabled": false,
    "evenBetterToml.formatter.arrayAutoExpand": true,
    "[yaml]": {
        "diffEditor.ignoreTrimWhitespace": true
    },
    "github-actions.use-enterprise": true,
    "chat.commandCenter.enabled": false,
    "yaml.customTags": [
        "!And",
        "!And sequence",
        "!If",
        "!If sequence",
        "!Not",
        "!Not sequence",
        "!Equals",
        "!Equals sequence",
        "!Or",
        "!Or sequence",
        "!FindInMap",
        "!FindInMap sequence",
        "!Base64",
        "!Join",
        "!Join sequence",
        "!Cidr",
        "!Ref",
        "!Sub",
        "!Sub sequence",
        "!GetAtt",
        "!GetAZs",
        "!ImportValue",
        "!ImportValue sequence",
        "!Select",
        "!Select sequence",
        "!Split",
        "!Split sequence"
    ],
    "git.blame.editorDecoration.enabled": false,
}
