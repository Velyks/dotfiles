Host *
  AddKeysToAgent yes
  UseKeychain yes
  IdentityFile ~/.ssh/id_rsa
Host home
  HostName home.gonnahate.org
  User velyks
  IdentityFile ~/.ssh/id_rsa_home.gonnahate.org
  DynamicForward localhost:2468
Host i-* mi-*
    ProxyCommand sh -c "aws ssm start-session --target %h --document-name AWS-StartSSHSession --parameters 'portNumber=%p'"
Host *.empire.lyst *.lyst.co *.lystit.com !git.lystit.com
    ProxyCommand sh -c "aws ssm start-session --target $(aws ec2 describe-instances --filters "Name=tag:Name,Values=$(echo %h | cut -d@ -f2)" "Name=instance-state-name,Values=running" --query 'Reservations[*].Instances[*].InstanceId' --output text) --document-name AWS-StartSSHSession --parameters 'portNumber=%p'"
Host git.lystit.com
  HostName git.lystit.com
  IdentityFile ~/.ssh/id_ed25519
Host github.com
  HostName github.com
  #IdentityFile ~/.ssh/id_ed25519_velyks
  IdentityFile ~/.ssh/id_ed25519_thomassands_github
