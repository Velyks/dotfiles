Host *
  AddKeysToAgent yes
  UseKeychain yes
  IdentityFile ~/.ssh/id_rsa
  StrictHostKeyChecking=accept-new
  PubkeyAcceptedAlgorithms +ssh-rsa
  HostkeyAlgorithms +ssh-rsa
Host home
  HostName home.gonnahate.org
  User velyks
  IdentityFile ~/.ssh/id_rsa_home.gonnahate.org
  DynamicForward localhost:2468
Host i-* mi-*
    ProxyCommand sh -c "aws ssm start-session --target %h --document-name AWS-StartSSHSession --parameters 'portNumber=%p'"
#Host *.empire.lyst *.lyst.co *.lystit.com !git.lystit.com !circleci.lystit.com !circleci-console.lystit.com !*.smart.lystit.com
